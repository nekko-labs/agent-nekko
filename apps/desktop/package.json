{
  "name": "@agent-nekko/desktop",
  "version": "0.8.0",
  "private": true,
  "description": "Agent Nekko desktop app.",
  "author": {
    "name": "Nekko Labs",
    "email": "support@agentnekko.com"
  },
  "homepage": "https://github.com/nekko-labs/agent-nekko",
  "desktopName": "Agent Nekko",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/dev-launch.mjs dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:subagents": "node scripts/subagent-integration.cjs",
    "test:wall-controls": "node scripts/wall-controls-integration.cjs",
    "test:command-center": "node scripts/command-center-integration.cjs",
    "prestart": "node scripts/ensure-electron.mjs",
    "start": "node scripts/dev-launch.mjs preview",
    "dist": "npm run build:app --prefix ../cli && electron-vite build && node scripts/stage-daemon.mjs && electron-builder",
    "release": "npm run build:app --prefix ../cli && electron-vite build && node scripts/stage-daemon.mjs && electron-builder --publish always"
  },
  "dependencies": {
    "@agent-nekko/core": "*",
    "@agent-nekko/host": "*",
    "@agent-nekko/shared": "*",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "ghostty-web": "^0.4.0",
    "mermaid": "^12.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  }
}
